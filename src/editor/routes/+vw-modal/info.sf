## html
<sf-m name="info-placeholder">
	<h1>Info (placeholder)</h1>
</sf-m>

## scss-global
sf-m[name="info-placeholder"] {
	background: #ffffff;
    color: black;
	padding: 20px;
	border-radius: 10px;
	max-width: 700px;
	border: 2px solid black;
	position: relative;
	// white-space: pre-line;
	box-shadow: 0 0 20px 0px white;
	h1{
		margin: 0;
		border-bottom: 1px dashed;
	}
	ul{
		list-style: decimal;
	}
	.small-note {
		font-size: 12px;
		color: #bfbfbf;
	}
}

## js-global
sf.model('info-placeholder', function(My){
	My.open = function(key){}
});