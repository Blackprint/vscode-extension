This template will be appended to body
For adding library or style, please modify /public/index.html

## html.append-to-body
<div class="background">
	<div class="img"></div>
	<div class="tile"></div>
</div>

<!-- Ground viewport -->
<!-- ./src/vw-ground/router.js -->
<vw-ground></vw-ground>

<input type="text" id="hidden_text" style="position: fixed; top: 100vh;">

<!-- /src/component/dropdown.sf -->
<sf-m name="dropdown" class="{{ className }} {{ hasSearch ? 'has-search':'' }} {{ searchActive ? 'search-active':'' }}">
  <drop-down sf-each="val in menus"></drop-down>
</sf-m>

<sf-template path="BPExtensionEditor/model/editor-error-display.sf"></sf-template>

## scss-global
body > .background {
	position: fixed;
	top: 0;
	left: 0;
	.img{
		position: fixed;
		opacity: 0.8;
		background-image: url('./img/background/black3.jpg');
		background-repeat: repeat;
		background-size: 75%;
		box-shadow: inset 0 0 11rem 0px black;
		width: 100%;
		height: 100%;
	}
	.tile{
		opacity: 0.8;
		position: fixed;
		background: url('./img/background/tile.png');
		background-repeat: repeat;
		background-size: 100px;
		width: 100%;
		box-shadow: inset 0 0 11rem 0px black;
		height: 100%;
		filter: brightness(28%);
	}
}

vw-ground{
	position: absolute;
	overflow: hidden;
	display: block;
	top: 0px;
	height: calc(100vh - 0px);
	width: 100vw;
}

@media(max-width: 800px){
	sf-m.modal {
		overflow: scroll;
	}
}

textarea, code {
	tab-size: 4;
}