## html
<sketch-panel-bottom class="panel {{ opened ? 'opened' : '' }}" @contextmenu="SmallNotif.add('Some panels still WIP')">
	<div class="opener" @click="opened ? closePanel(event) : openPanel()">
		<i class="fas fa-chevron-{{ opened ? 'down' : 'up' }}"></i>
	</div>
	<div class="content">
		<div class="buttons">
			<div @click="executionPauseSwitch" title="{{ r_execOrder.pause ? 'Start data flow' : 'Pause data flow' }}" class="button {{
				execOrder.pause && execOrder.length === 0 && !execOrder._hasStepPending ? 'inactive' : ''
			}}"><i class="fa fa-{{ r_execOrder.pause ? 'play' : 'pause' }}"></i> {{
				r_execOrder.pause ? 'Next' : 'Pause'
			}}</div>
			<div @click="executionStepMode" title="Begin step mode that automatically pause on any data flow or node execution" class="button {{ r_execOrder.stepMode ? 'active' : '' }}">
				<i class="fa fa-shoe-prints"></i> Step Mode
			</div>
			<div @click="sketchRefresh" title="Recalculate cable and node position" class="button" ><i class="fa fa-sitemap"></i> Refresh</div>
			<div @click="runBlackprintCLI" title="Run this file as an entry file on your CLI" class="button"><i class="fa fa-terminal"></i> Run in CLI</div>
			<div @click="connectRemote" title="Connect to remote engine and control/debug it from this editor" class="button {{ RemoteSketchConnect.isConnected ? 'socket-connected' : '' }}"><i class="fa fa-satellite-dish"></i> Remote</div>
		</div>
		<div class="description">
			<div class="debug-desc">{{ noteTitle }} <span>{{ note }}</span></div>
			<div>If you want to access to any external URL or remote engine you must whitelist on editor settings first</div>
		</div>
	</div>
</sketch-panel-bottom>

## scss-global
body sketch-page > .panels sketch-panel-bottom {
	backdrop-filter: blur(1px); // Long CSS rule = more priority
}

sketch-page > .panels sketch-panel-bottom {
    position: absolute;
    left: 50%;
	width: calc(100% - 200px - 240px - 80px);
	margin-left: -20px;
	bottom: 0;
	border: 1px solid #181818;
	transform: translate(-50%, 90px);
	transition: 0.3s ease-out transform;
	display: flex;
	background: #00000085;
	align-items: center;
	.content {
		visibility: hidden;
		justify-content: center;
		text-align: center;
		height: 80px;
		width: 100%;
		padding: 10px;
		color: #ffffff8a;

		.buttons {
			background: #0000004a;
			border: 1px solid #747474;
			border-radius: 50px;
			height: 24px;
			text-align: left;
			margin-top: 5px;
			padding: 0 10px;
			display: flex;
			user-select: none;
			justify-content: center;

			.button {
				color: white;
				font-size: 15px;
				line-height: 26px;
				padding: 0 8px;
				min-width: 70px;
				cursor: pointer;

				&.inactive{
					color: grey;

					&:hover{
						text-shadow: unset;
					}
				}

				&:hover{
					text-shadow: 0 0 5px white;
				}

				& + .button{
					border-left: 1px dashed white;
				}

				&.active {
					color: yellow;
				}

				&.socket-connected {
					color: lightgreen;
				}
			}
		}

		.description{
			top: 10px;
			position: relative;
			width: 100%;

			.debug-desc {
				cursor: unset;
				color: yellow;
				font-size: 14px;
				min-height: 20px;

				span{
					color: white;
				}

				&:hover{
					text-shadow: unset;
				}
			}
		}
	}
	.opener{
		cursor: pointer;
		height: 10px;
		display: flex;
		width: 100%;
		justify-content: center;
		position: absolute;
		top: 0;
		i {
			color: #ffffff70;
			position: absolute;
			top: 0;
			font-size: 12px;
			display: block;
		}
	}
	&.opened {
		transform: translate(-50%, 0);
		.content {
			visibility: visible;
		}
	}
}
.anim-element sketch-page > .panels sketch-panel-bottom.opened .content {
	visibility: hidden;
}

## js-global
sf.component('sketch-panel-bottom', {template: #this.path}, function(My){
	My.opened = false;
	My.sketchPage = null;
	My.instance = null;
	My.execOrder = null;
	My.r_execOrder = {pause: false, stepMode: false}; // Remote engine + Editor's engine status
	My.noteTitle = '';
	My.note = '';
	My.stepModeIsRequesting = '';
	My.RemoteSketchConnect = sf.model('modal-remote-sketch-connect');

	My.beforeInit = async function(){
		await new Promise(resolve => {
			$(()=> setTimeout(resolve, 500));
		});

		My.sketchPage = $('vw-page > .page-current > sketch-page')[0].model;
		My.sketchPage.panels.bottom = My;
		My.instance = My.sketchPage.sketch;
		My.execOrder = My.instance.executionOrder;

		sf.watch(My.execOrder, 'pause', (old, now)=> {
			if(My.instance._remote) return; My.r_execOrder.pause = now;
		});
		sf.watch(My.execOrder, 'stepMode', (old, now)=> {
			if(My.instance._remote) return; My.r_execOrder.stepMode = now;
		});

		sf.watch(My.instance, '_remote', hasRemote);
		if(My.instance._remote) hasRemote();
		function hasRemote(){
			My.hasRemote = true;
			let remote = My.instance._remote;
			let ifaceList = My.instance.ifaceList;

			function findCable(info){
				if(info == null) return null;

				let iface = ifaceList[info.out.i];
				let output = iface.output;

				let cables = output[info.out.name].cables;
				let cable = null;
				for (let i=0; i < cables.length; i++) {
					let ref = cables[i];
					if(ref.output.iface.i === info.out.i && ref.input?.iface.i === info.in?.i){
						cable = ref;
						break;
					}
				}

				return cable;
			}

			remote.on('stepmode.enabled', data => {
				My.r_execOrder.stepMode = data.flag;
				if(data.flag) My.opened = true;
			});
			remote.on('stepmode.paused', data => {
				My.r_execOrder.pause = data.pause;
				if(data.pause) My.opened = true;
				else {
					My.instance._emit('execution.paused', {
						afterNode: null,
						beforeNode: null,
						cable: null,
						cables: null,
						triggerSource: 0,
					});
				}
			});
			remote.on('stepmode.status', data => {
				My.r_execOrder.pause = true;
				My.instance._emit('execution.paused', {
					afterNode: data.afterNode != null ? ifaceList[data.afterNode].node : null,
					beforeNode: data.beforeNode != null ? ifaceList[data.beforeNode].node : null,
					cable: findCable(data.cable),
					cables: data.cables?.map(findCable),
					triggerSource: data.triggerSource,
				});
			});
		}
	}

	function removeBlur(){
		My.$el.css('backdrop-filter', 'none');
		setTimeout(()=> My.$el.css('backdrop-filter', ''), 300);
	}

	My.executionPauseSwitch = function(){
		let executionOrder = My.instance.executionOrder;
		My.sketchPage.$el('.debug-after-node, .debug-next, .debug-cable')
			.removeClass('debug-after-node')
			.removeClass('debug-cable')
			.removeClass('debug-next');

		if(!My.stepModeIsRequesting){
			// Remove all port value display element from the last pause session
			My.sketchPage.$el('editor-display-port-value').remove();
		}

		if(My.hasRemote){
			if(My.r_execOrder.pause) My.instance._remote.pauseExecution(false);
			else My.instance._remote.pauseExecution(true);
		}
		else{
			if(executionOrder.pause){
				My.noteTitle = My.note = '';
				executionOrder.pause = false;
				executionOrder.next(true);
			}
			else executionOrder.pause = true;
		}
	}

	My.executionStepMode = function(){
		let executionOrder = My.instance.executionOrder;
		executionOrder.stepMode = !executionOrder.stepMode;

		if(My.hasRemote){
			if(My.r_execOrder.stepMode) My.instance._remote.enableStepMode(false);
			else My.instance._remote.enableStepMode(true);
		}
		else{
			if(executionOrder.stepMode) executionOrder.pause = true;
		}
	}

	My.sketchRefresh = function(){
		CurrentSketch.recalculatePosition();
	}

	My.runBlackprintCLI = function(){
		vscode.postMessage({ type: 'runBlackprintCLI', data: { withRemote: false } });
	}

	My.connectRemote = async function(){
		let confirm = await Swal.fire({
			title: "Remote Control",
			text: "Do you want to run this instance on your CLI and connect it to this editor, or just run the relay server to connect to a different remote engine?",
			confirmButtonText: 'Run and connect',
			denyButtonText: 'Relay server only',
			cancelButtonText: My.RemoteSketchConnect.isConnected ? 'Open tools' : 'Connect to...',
			denyButtonColor: 'gray',
			cancelButtonColor: 'gray',
			showDenyButton: true,
			showCancelButton: true,
			showCloseButton: true
		});

		if(confirm.isDismissed && confirm.dismiss === 'backdrop')
			return;

		let option = {};
		if(confirm.isConfirmed){ // Run and connect
			vscode.postMessage({ type: 'runBlackprintCLI', data: { withRemote: true } });
		}
		else if(confirm.isDenied){ // Relay server only
			vscode.postMessage({ type: 'runSocketRelay' });
		}
		else { // Open remote tools
			if(sf.model('modal-remote-sketch-connect').socket?.connected){
				Modal.goto('/remote-sync');
			}
			else Modal.goto('/remote-sketch-connect');
		}
	}

	My.openPanel = function(){
		removeBlur();
		My.opened = true;
	}

	My.closePanel = function(ev){
		removeBlur();
		ev.stopPropagation();
		My.opened = false;
	}
});