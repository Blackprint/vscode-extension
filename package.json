{
  "name": "blackprint-vscode-extension",
  "private": true,
  "displayName": "Blackprint Visual Programming",
  "author": "StefansArya",
  "description": "Blackprint Editor for VSCode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Blackprint",
      "properties": {
        "blackprint.whitelistedUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of whitelisted URLs for the Blackprint Editor"
        },
        "blackprint.runtime": {
          "type": "string",
          "enum": [
            "Node.js",
            "Bun"
          ],
          "default": "Node.js",
          "description": "Select the runtime to use for running Blackprint files"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "blackprint.viewer",
        "displayName": "Blackprint Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.bpi"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "blackprint",
        "extensions": [
          ".bpi"
        ],
        "aliases": [
          "Blackprint",
          "blackprint"
        ],
        "icon": {
          "light": "./icons/bpi-icon.png",
          "dark": "./icons/bpi-icon.png"
        }
      }
    ],
    "commands": [
      {
        "command": "blackprint.openAsText",
        "title": "Blackprint: Open file as text"
      },
      {
        "command": "blackprint.newFile",
        "title": "Blackprint: New Blackprint instance file"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == blackprint",
          "command": "blackprint.openAsText",
          "group": "blackprint"
        },
        {
          "command": "blackprint.newFile",
          "group": "blackprint"
        }
      ],
      "file/newFile": [
        {
          "command": "blackprint.newFile",
          "group": "blackprint"
        }
      ]
    },
    "iconThemes": [
      {
        "id": "blackprint-icons",
        "label": "Blackprint Icons",
        "path": "./icons/icon-theme.json"
      }
    ]
  },
  "main": "./src/extension/index.js",
  "scripts": {
    "start": "gulp",
    "compile": "gulp compile",
    "update-editor-asset-dependency": "node ./src/utils/update-editor-asset-dependency.js"
  },
  "dependencies": {
    "@melloware/coloris": "^0.25.0",
    "scarletsframe": "^0.35.26",
    "vscode-ext-codicons": "^1.0.0",
    "vscode-ext-decoration": "1.1.0",
    "vscode-ext-help-and-feedback-view": "^1.0.1",
    "vscode-ext-selection": "1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/parser": "^7.23.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@babel/preset-env": "^7.23.9",
    "@types/glob": "^8.1.0",
    "@types/node": "^24.0.3",
    "@types/vscode": "^1.78.0",
    "@vscode/test-electron": "^2.5.2",
    "chokidar": "^3.6.0",
    "gulp": "^4.0.2",
    "node-notifier": "^9.0.1",
    "scarletsframe-compiler": "^0.7.1",
    "source-map-support": "^0.5.21",
    "through2": "^4.0.2",
    "vinyl": "^3.0.0"
  }
}